# Caption-Studio environment variables (all optional - defaults shown).

# Default llama.cpp server URL pre-filled in the UI on first load.
# Users can still change it in the server-check panel.
DEFAULT_SERVER_URL=http://localhost:8080

# Override for host reachability of server-side outbound fetches.
# Inside Docker, set this to host.docker.internal so browser-supplied
# "localhost" URLs resolve to the host machine running llama.cpp.
#DOCKER_HOST_INTERNAL=host.docker.internal

# Base URL of the WD Tagger microservice (see tag-service/).
# In the docker compose stack this is the "tag-service" service on 8801.
TAG_SERVICE_URL=http://localhost:8801
